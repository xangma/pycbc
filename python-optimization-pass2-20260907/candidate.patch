+@pytest.mark.parametrize("dtype", (torch.complex64, torch.complex128))
+@pytest.mark.parametrize("stride", (1, 3))
+def test_squared_norm_second_derivatives(torch_cpu, dtype, stride):
+    """Reusing an intermediate must preserve higher-order differentiation."""
+    generator = torch.Generator().manual_seed(2017)
+    tensor = torch.randn(4096 * stride, dtype=dtype, generator=generator,
+                         requires_grad=True)
+    view = tensor[::stride]
+    expected = torch.view_as_real(view).square().sum(dim=-1)
+    actual = _squared_norm(view)
+    expected_gradient, = torch.autograd.grad(
+        expected.sum(), tensor, create_graph=True
+    )
+    actual_gradient, = torch.autograd.grad(
+        actual.sum(), tensor, create_graph=True
+    )
+    torch.testing.assert_close(
+        actual_gradient, expected_gradient, rtol=0, atol=0
+    )
+    expected_second, = torch.autograd.grad(
+        expected_gradient.real.sum() + expected_gradient.imag.sum(), tensor
+    )
+    actual_second, = torch.autograd.grad(
+        actual_gradient.real.sum() + actual_gradient.imag.sum(), tensor
+    )
+    torch.testing.assert_close(actual_second, expected_second, rtol=0, atol=0)
+
