+@pytest.mark.parametrize("dtype", [np.complex64, np.complex128])
+@pytest.mark.parametrize("count", [1, 32, 1024])
+def test_cpu_peak_components_preserve_exact_reduction(dtype, count, monkeypatch):
+    # Exercise several full chunks plus a final partial chunk on small inputs.
+    monkeypatch.setattr(matchedfilter, "_TORCH_CPU_PEAK_MAX_ELEMENTS", 768)
+    rng = np.random.default_rng(7101)
+    rows = (rng.normal(size=(count, 257))
+            + 1j * rng.normal(size=(count, 257))).astype(dtype)
+    # Boundaries, equal magnitudes, non-finite values, and nearly equal peaks
+    # must retain the same first-index decision as the original reduction.
+    rows[:, 0] = 1e10
+    rows[:, -1] = 1e10
+    for row in range(count):
+        case = row % 4
+        if case == 0:
+            rows[row, 20:22] = [10, -10j]
+        elif case == 1:
+            rows[row, 20:22] = [np.inf, np.nan]
+        elif case == 2:
+            rows[row, 20:22] = [10 + 1e-7j, -10j]
+        else:
+            rows[row, 20:22] = [complex(-0.0, 0.0), complex(0.0, -0.0)]
+
+    with scheme.TorchScheme("cpu"):
+        output = Array(rows.reshape(-1))
+        values = output._data.tensor.reshape(count, 257)[:, 1:-1]
+        expected_indices = torch.argmax(
+            torch.view_as_real(values).square().sum(dim=-1), dim=-1
+        )
+        expected_peaks = values[torch.arange(count), expected_indices]
+        indices, peaks = matchedfilter._torch_batch_peak_values(
+            output, count, 257, slice(1, -1)
+        )
+        np.testing.assert_array_equal(indices, expected_indices.numpy())
+        np.testing.assert_array_equal(peaks, expected_peaks.numpy())
+
+
 def _run_without_scalar_sync(batch, monkeypatch):
     copies = []
     original_cpu = torch.Tensor.cpu
diff --git a/test/test_torch_batch_overlap_scaling.py b/test/test_torch_batch_overlap_scaling.py
new file mode 100644
index 0000000000..56c9ef9cb0
--- /dev/null
+++ b/test/test_torch_batch_overlap_scaling.py
@@ -0,0 +1,128 @@
+# Copyright (C) 2026 The PyCBC Collaboration
+#
