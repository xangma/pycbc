+def _torch_batch_peak_values(output, template_count, template_size, segment):
+    if not isinstance(pycbc.scheme.mgr.state, pycbc.scheme.TorchScheme):
+        return None
+    tensor = backend_array(output, 'torch')
+    if tensor is None or tensor.ndim != 1:
+        return None
+    template_count = int(template_count)
+    template_size = int(template_size)
+    if template_count < 1 or template_size < 1 or tensor.numel() != template_count * template_size:
+        return None
+    if segment.step not in (None, 1):
+        return None
+    if tensor.device.type == 'cuda':
+        native = _try_torch_cuda_native_batch_peak_values(output, tensor, template_count, template_size, segment)
+        if native is not None:
+            return native
+    import torch
+    values = tensor.reshape(template_count, template_size)[:, segment]
+    if values.shape[1] == 0:
+        return None
+    if values.device.type != 'cpu':
+        if values.is_complex():
+            sq_mag = torch.view_as_real(values).square().sum(dim=-1)
+        else:
+            sq_mag = values.square()
+        indices = torch.argmax(sq_mag, dim=-1)
+        peaks = values[torch.arange(values.shape[0], device=values.device), indices]
+    else:
+        rows_per_chunk = max(1, _TORCH_CPU_PEAK_MAX_ELEMENTS // values.shape[1])
+        index_chunks = []
+        peak_chunks = []
+        for chunk in values.split(rows_per_chunk):
+            if chunk.is_complex():
+                sq_mag = chunk.real.square() + chunk.imag.square()
+            else:
+                sq_mag = chunk.square()
+            indices = torch.argmax(sq_mag, dim=-1)
+            peaks = chunk[torch.arange(chunk.shape[0], device=chunk.device), indices]
+            index_chunks.append(indices)
+            peak_chunks.append(peaks)
+        if len(index_chunks) > 1:
+            indices = torch.cat(index_chunks)
+            peaks = torch.cat(peak_chunks)
+    return (indices.detach().cpu().numpy(), peaks.detach().cpu().numpy())
