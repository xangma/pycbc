+        if any((not isinstance(node, allowed_nodes) or (isinstance(node, ast.keyword) and id(node) not in keyword_nodes) or (isinstance(node, ast.Constant) and (not (isinstance(node.value, (int, float)) or (isinstance(node.value, str) and id(node) in string_constants)))) or (isinstance(node, ast.Compare) and len(node.ops) != 1) for node in ast.walk(tree))):
