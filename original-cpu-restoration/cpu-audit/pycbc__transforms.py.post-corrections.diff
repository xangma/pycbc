+    def tensor_function(torch_name):
+        function = getattr(torch, torch_name)
+
+        def evaluate(*args):
+            operand = next((arg for arg in args if isinstance(arg, torch.Tensor)), reference)
+            dtype = operand.dtype if operand.is_floating_point() or operand.is_complex() else None
+            return function(*(arg if isinstance(arg, torch.Tensor) else torch.as_tensor(arg, device=operand.device, dtype=dtype) for arg in args))
+        return evaluate
+    context = {name: value for name, value in record._numpy_function_lib.items() if isinstance(value, float)}
