+    import fcntl
+except ImportError:  # pragma: no cover - unavailable on Windows
+    fcntl = None
+
+
+logger = logging.getLogger("pycbc.fft.wisdom_cache")
+
+_CACHE_SCHEMA = 1
+_ROUTE_VERSION = 1
+_SEARCH_IFFT_SIZE = 131072
+_CPUINFO_KEYS = (
+    "vendor_id",
+    "cpu family",
+    "model",
+    "model name",
+    "stepping",
+    "microcode",
+    "flags",
+)
+
+
+@dataclass
