SingleDetSGChisq.insert_option_group(parser)
opt = parser.parse_args()

# Check that the values returned for the options make sense
psd.verify_psd_options(opt, parser)
strain.verify_strain_options(opt, parser)
strain.StrainSegments.verify_segment_options(opt, parser)
scheme.verify_processing_options(opt, parser)
fft.verify_fft_options(opt,parser)
pycbc.opt.verify_optimization_options(opt, parser)

pycbc.init_logging(opt.verbose)

fft.from_cli(opt)
inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli(opt)
ctx = scheme.from_cli(opt)

scheme_name = str(getattr(ctx, "device_spec", getattr(ctx, "prefix", getattr(ctx, "name", "")))).lower()
is_cuda = "cuda" in scheme_name
is_jax = (
    (hasattr(scheme, "JAXScheme") and isinstance(ctx, scheme.JAXScheme))
    or "jax" in scheme_name
)
is_torch = (
    (hasattr(scheme, "TorchScheme") and isinstance(ctx, scheme.TorchScheme))
    or "torch" in scheme_name
)

if opt.batch_size is not None:
    batch_size = max(1, int(opt.batch_size))
elif is_cuda:
    batch_size = 64
elif is_jax or is_torch:
    batch_size = 16
else:
    batch_size = 1

use_batching = (batch_size > 1)

def template_triggers(t_num):
    """ Get the triggers for a specific template
    """
    template = None
    tparam = None
    out_vals_all = []
    for s_num, stilde in enumerate(segments):
        # Filter check checks the 'inj_filter_rejector' options to
        # determine whether
        # to filter this template/segment if injections are present.
        if not inj_filter_rejector.template_segment_checker(
                bank, t_num, stilde):
            continue
        if template is None:
            template = bank[t_num]
            tparam = template.params

        if opt.update_progress:
            update_progress((t_num + (s_num / float(len(segments))) ) / len(bank),
                            opt.update_progress, opt.update_progress_file)
        logging.info("Filtering template %d/%d segment %d/%d" %
                     (t_num + 1, len(bank), s_num + 1, len(segments)))

        sigmasq = template.sigmasq(stilde.psd)
        snr, norm, corr, idx, snrv = \
           matched_filter.matched_filter_and_cluster(s_num,
                                                     sigmasq,
                                                     cluster_window,
                                                     epoch=stilde._epoch)
        if not len(idx):
            continue

        out_vals = out_vals_ref.copy()
        out_vals['bank_chisq'], out_vals['bank_chisq_dof'] = \
              bank_chisq.values(template, stilde.psd, stilde, snrv, norm,
                                idx+stilde.analyze.start)

        out_vals['chisq'], out_vals['chisq_dof'] = \
              power_chisq.values(corr, snrv, norm, stilde.psd,
                                 idx+stilde.analyze.start, template)

        out_vals['sg_chisq'] = sg_chisq.values(stilde, template, stilde.psd,
                                      snrv, norm,
                                      out_vals['chisq'],
                                      out_vals['chisq_dof'],
                                      idx+stilde.analyze.start)

        out_vals['cont_chisq'], _ = \
              autochisq.values(snr, idx+stilde.analyze.start, template,
                               stilde.psd, norm, stilde=stilde,
                               low_frequency_cutoff=flow)

        idx += stilde.cumulative_index

        out_vals['time_index'] = idx
        out_vals['snr'] = snrv * norm
        out_vals['sigmasq'] = numpy.zeros(len(snrv), dtype=float32) + sigmasq
        if opt.psdvar_short_segment is not None:
            out_vals['psd_var_val'] = \
                        pycbc.psd.find_trigger_value(psd_var,
                                      out_vals['time_index'],
                                      opt.gps_start_time, opt.sample_rate)
        #print(idx, out_vals['time_index'])

        out_vals_all.append(copy.deepcopy(out_vals))
        #print(out_vals_all)
    return out_vals_all, tparam


def batch_template_triggers(batch_tnums):
    """ Get the triggers for a batch of templates
    """
    flow = getattr(opt, "low_frequency_cutoff", None)
    b = len(batch_tnums)
    if b == 0:
        return []

    if hasattr(bank, "get_batch"):
        batch_templates = bank.get_batch(batch_tnums)
        tparams = [tmpl.params for tmpl in batch_templates]
    else:
        batch_templates = []
        tparams = []
        for i, t_num in enumerate(batch_tnums):
            if tile_mem is not None:
                bank.out = tile_mem[i]
            tmpl = bank[t_num]
            batch_templates.append(tmpl)
            tparams.append(tmpl.params)

    out_vals_all_list = [[] for _ in range(b)]
    sigmasq_caches = [{} for _ in range(b)]

    for s_num, stilde in enumerate(segments):
        active_indices = []
        active_templates = []
        active_sigmasqs = []
        psd_id = id(stilde.psd)

        if use_batching and b > 0 and psd_id not in sigmasq_caches[0]:
            from pycbc import scheme
            state = getattr(scheme.mgr, "state", None)
            if state is not None and hasattr(scheme, "JAXScheme") and isinstance(state, scheme.JAXScheme):
                from pycbc.filter.matchedfilter_jax import batch_sigmasq_jax
                batch_ssq = batch_sigmasq_jax(batch_templates, stilde.psd)
                for i_t, ssq_val in enumerate(batch_ssq):
                    sigmasq_caches[i_t][psd_id] = ssq_val

                if power_chisq.do and getattr(batch_templates, "_batch_tensor", None) is not None:
                    from pycbc.vetoes.chisq_jax import batch_power_chisq_bins_jax
                    from pycbc.opt import LimitedSizeDict
                    num_bins = int(power_chisq.parse_option(batch_templates[0], power_chisq.num_bins))
                    flow = opt.low_frequency_cutoff
                    batch_bins = batch_power_chisq_bins_jax(
                        batch_templates, num_bins, stilde.psd, low_frequency_cutoff=flow
                    )
                    if not hasattr(stilde.psd, "_chisq_cached_key"):
                        stilde.psd._chisq_cached_key = {}
                    for i_t, tmpl in enumerate(batch_templates):
                        if not hasattr(tmpl, "_bin_cache"):
                            tmpl._bin_cache = LimitedSizeDict(size_limit=4)
                        tmpl._bin_cache[psd_id] = batch_bins[i_t]
                        stilde.psd._chisq_cached_key[id(tmpl.params)] = True

        for i, t_num in enumerate(batch_tnums):
            if not inj_filter_rejector.template_segment_checker(
                    bank, t_num, stilde):
                continue
            active_indices.append(i)
            tmpl = batch_templates[i]
            active_templates.append(tmpl)
            if psd_id in sigmasq_caches[i]:
                sigmasq = sigmasq_caches[i][psd_id]
            else:
                sigmasq = tmpl.sigmasq(stilde.psd)
                sigmasq_caches[i][psd_id] = sigmasq
            active_sigmasqs.append(sigmasq)

        if not active_indices:
            continue

        batch_tensor = getattr(batch_templates, "_batch_tensor", None)
        if batch_tensor is not None:
            from pycbc.waveform.bank import TemplateBatchList
            act_list = TemplateBatchList(active_templates)
            if len(active_indices) == len(batch_templates):
                act_list._batch_tensor = batch_tensor
            else:
                import jax.numpy as jnp
                act_list._batch_tensor = batch_tensor[jnp.asarray(active_indices)]
            active_templates = act_list

        if opt.update_progress:
            update_progress((batch_tnums[0] + (s_num / float(len(segments)))) / len(bank),
                            opt.update_progress, opt.update_progress_file)
        logging.info("Filtering template batch %d-%d/%d segment %d/%d" %
                     (batch_tnums[0] + 1, batch_tnums[-1] + 1, len(bank), s_num + 1, len(segments)))

        batch_results = matched_filter.batched_matched_filter_and_cluster(
            s_num,
            active_templates,
            active_sigmasqs,
            cluster_window,
            epoch=stilde._epoch,
        )

        chisq_map = None
        if power_chisq.do and use_batching:
            from pycbc import scheme
            _cur_state = getattr(scheme.mgr, "state", None)
            if _cur_state is not None and hasattr(scheme, "JAXScheme") and isinstance(_cur_state, scheme.JAXScheme):
                corr_tensor = None
                for res in batch_results:
                    if res[2] is not None and hasattr(res[2], "_batch_tensor"):
                        corr_tensor = res[2]._batch_tensor
                        break
                if corr_tensor is not None:
                    from pycbc.vetoes.chisq_jax import batch_power_chisq_jax
                    chisq_map = batch_power_chisq_jax(
                        corr_tensor,
                        batch_results,
                        active_templates,
                        stilde.psd,
                        stilde.analyze.start,
                        snr_threshold=power_chisq.snr_threshold,
                        power_chisq=power_chisq,
                    )

        for act_pos, tmpl_idx in enumerate(active_indices):
            snr, norm, corr, idx, snrv = batch_results[act_pos]
            if not len(idx):
                continue

            tmpl = active_templates[act_pos]
            sigmasq = active_sigmasqs[act_pos]

            out_vals = out_vals_ref.copy()
            out_vals['bank_chisq'], out_vals['bank_chisq_dof'] = \
                  bank_chisq.values(tmpl, stilde.psd, stilde, snrv, norm,
                                    idx+stilde.analyze.start)

            if chisq_map is not None and act_pos in chisq_map:
                out_vals['chisq'], out_vals['chisq_dof'] = chisq_map[act_pos]
                if power_chisq.snr_threshold:
                    num_above = int((abs(snrv * norm) > power_chisq.snr_threshold).sum())
                    logging.info('%s above chisq activation threshold' % num_above)
            else:
                out_vals['chisq'], out_vals['chisq_dof'] = \
                      power_chisq.values(corr, snrv, norm, stilde.psd,
                                         idx+stilde.analyze.start, tmpl)

            out_vals['sg_chisq'] = sg_chisq.values(stilde, tmpl, stilde.psd,
                                          snrv, norm,
                                          out_vals['chisq'],
                                          out_vals['chisq_dof'],
                                          idx+stilde.analyze.start)

            out_vals['cont_chisq'], _ = \
                  autochisq.values(snr, idx+stilde.analyze.start, tmpl,
                                   stilde.psd, norm, stilde=stilde,
                                   low_frequency_cutoff=flow)

            idx_cum = idx + stilde.cumulative_index

            out_vals['time_index'] = numpy.asarray(idx_cum)
            out_vals['snr'] = numpy.asarray(snrv * norm)
            out_vals['sigmasq'] = numpy.zeros(len(snrv), dtype=float32) + sigmasq
            if out_vals['chisq'] is not None:
                out_vals['chisq'] = numpy.asarray(out_vals['chisq'])
            if out_vals['chisq_dof'] is not None:
                out_vals['chisq_dof'] = numpy.asarray(out_vals['chisq_dof'])
            if opt.psdvar_short_segment is not None:
                out_vals['psd_var_val'] = \
                            pycbc.psd.find_trigger_value(psd_var,
                                          out_vals['time_index'],
                                          opt.gps_start_time, opt.sample_rate)

            out_vals_all_list[tmpl_idx].append(copy.deepcopy(out_vals))

        batch_results = None
        # The veto lookup also holds the correlation tensor through these
        # locals. Release it before allocating the next segment's FFT buffers.
        corr_tensor = None
        res = None
        snr = None
        corr = None
        active_templates = None
        tmpl = None
        active_indices = None
        active_sigmasqs = None

    active_templates = None
    tmpl = None
    active_indices = None
    active_sigmasqs = None
    sigmasq_caches = None
    if hasattr(bank, "clear_batch_cache"):
        # The enclosing cleanup below runs after all references held by this
        # batch have been released. Avoid a redundant full collection while
        # preserving the historical default for non-JAX callers.
        if is_jax:
            bank.clear_batch_cache(batch_tnums, collect=False)
        else:
            bank.clear_batch_cache(batch_tnums)
    if hasattr(matched_filter, "clear_batch_cache"):
        matched_filter.clear_batch_cache()
    batch_templates = None
    import gc
    gc.collect()

    return list(zip(out_vals_all_list, tparams))


with ctx:
    if opt.fft_backends == 'fftw':

        # The following FFTW specific options needed to wait until
        # we were inside the scheme context.

        # Import system wisdom.
        if opt.fftw_import_system_wisdom:
            fft.fftw.import_sys_wisdom()

        # Read specified user-provided wisdom files
        if opt.fftw_input_float_wisdom_file is not None:
            fft.fftw.import_single_wisdom_from_filename(opt.fftw_input_float_wisdom_file)

        if opt.fftw_input_double_wisdom_file is not None:
            fft.fftw.import_double_wisdom_from_filename(opt.fftw_input_double_wisdom_file)

    gwstrain = strain.from_cli(opt, dyn_range_fac=DYN_RANGE_FAC,
                               inj_filter_rejector=inj_filter_rejector)

    strain_segments = strain.StrainSegments.from_cli(opt, gwstrain)

    flow = opt.low_frequency_cutoff
    flen = strain_segments.freq_len
    tlen = strain_segments.time_len
    delta_f = strain_segments.delta_f


    logging.info("Making frequency-domain data segments")
    segments = strain_segments.fourier_segments()
    psd.associate_psds_to_segments(opt, segments, gwstrain, flen, delta_f,
                  flow, dyn_range_factor=DYN_RANGE_FAC, precision='single')

    # storage for values and types to be passed to event manager
    out_types = {
        'time_index'     : int,
        'snr'            : complex64,
        'chisq'          : float32,
        'chisq_dof'      : int,
        'bank_chisq'     : float32,
        'bank_chisq_dof' : int,
        'cont_chisq'     : float32,
        'psd_var_val'    : float32,
        'sigmasq'        : float32,
                }
    out_types.update(SingleDetSGChisq.returns)
    out_vals_ref = {key: None for key in out_types}
    names = sorted(out_vals_ref.keys())

    if len(strain_segments.segment_slices) == 0:
        logging.info("--filter-inj-only specified and no injections in analysis time")
        event_mgr = events.EventManager(
              opt, names, [out_types[n] for n in names], psd=None,
              gating_info=gwstrain.gating_info)
        event_mgr.finalize_template_events()
        event_mgr.write_events(opt.output)
        logging.info("Finished")
        sys.exit(0)

    # FIXME: Maybe we should use the PSD corresponding to each trigger
    if opt.psdvar_segment is not None:
        logging.info("Calculating PSD variation")
        psd_var = pycbc.psd.calc_filt_psd_variation(gwstrain, opt.psdvar_segment,
                opt.psdvar_short_segment, opt.psdvar_long_segment,
                opt.psdvar_psd_duration, opt.psdvar_psd_stride,
                opt.psd_estimation, opt.psdvar_low_freq, opt.psdvar_high_freq)


    if opt.enable_q_transform:
        logging.info("Performing q-transform on analysis segments")
        q_trans = qtransform.inspiral_qtransform_generator(segments)

    else:
        q_trans = {}

    if opt.checkpoint_interval:
        checkpoint_file = opt.output + '.checkpoint'

    checkpoint_exists = False
    tnum_start = 0
    if (opt.checkpoint_interval and os.path.isfile(checkpoint_file)):
        try:
            tnum_start, event_mgr = events.EventManager.restore_state(checkpoint_file)
            checkpoint_exists = True
        except Exception as e:
            if args.require_valid_checkpoint:
                logging.info("Failed to load checkpoint file")
                raise(e)

            logging.info('Failed to load checkpoint file, starting anew')
            logging.info(e)

    if not checkpoint_exists:
        event_mgr = events.EventManager(
            opt, names, [out_types[n] for n in names], psd=segments[0].psd,
            gating_info=gwstrain.gating_info, q_trans=q_trans)

    # Keep one buffer for the matched filter and allocate the remaining tile
    # buffers only for banks that use the scalar fallback below.
    tile_mem = None
    template_mem = zeros(tlen, dtype=complex64)
    cluster_window = int(opt.cluster_window * gwstrain.sample_rate)

    if opt.cluster_window == 0.0:
        use_cluster = False
    else:
        use_cluster = True

    if hasattr(ctx, "num_threads"):
            ncores = ctx.num_threads
    else:
            ncores = 1
    if opt.multiprocessing_nprocesses:
        ncores *= opt.multiprocessing_nprocesses


    matched_filter = MatchedFilterControl(opt.low_frequency_cutoff, None,
                                   opt.snr_threshold, tlen, delta_f, complex64,
                                   segments, template_mem, use_cluster,
                                   downsample_factor=opt.downsample_factor,
                                   upsample_threshold=opt.upsample_threshold,
                                   upsample_method=opt.upsample_method,
                                   gpu_callback_method=opt.gpu_callback_method,
                                   cluster_function=opt.cluster_function)

    bank_chisq = vetoes.SingleDetBankVeto(opt.bank_veto_bank_file,
                                          flen, delta_f, flow, complex64,
                                          phase_order=opt.order,
                                          approximant=opt.approximant)

    power_chisq = vetoes.SingleDetPowerChisq(opt.chisq_bins, opt.chisq_snr_threshold)

    autochisq = vetoes.SingleDetAutoChisq(opt.autochi_stride,
                                 opt.autochi_number_points,
                                 onesided=opt.autochi_onesided,
                                 twophase=opt.autochi_two_phase,
                                 reverse_template=opt.autochi_reverse_template,
                                 take_maximum_value=opt.autochi_max_valued,
                                 maximal_value_dof=opt.autochi_max_valued_dof)
    matched_filter.need_snr_series = bool(autochisq.do)

    logging.info("Overwhitening frequency-domain data segments")
    for seg in segments:
        seg /= seg.psd

    logging.info("Read in template bank")
    bank = waveform.FilterBank(opt.bank_file, flen, delta_f,
        low_frequency_cutoff=None if opt.enable_bank_start_frequency else flow,
        dtype=complex64, phase_order=opt.order,
        taper=opt.taper_template, approximant=opt.approximant,
        out=None if use_batching else template_mem, max_template_length=opt.max_template_length,
        enable_compressed_waveforms=True if opt.use_compressed_waveforms else False,
        waveform_decompression_method=
        opt.waveform_decompression_method if opt.use_compressed_waveforms else None)

    if use_batching and not hasattr(bank, "get_batch"):
        tile_mem = [template_mem] + [
            zeros(tlen, dtype=complex64) for _ in range(batch_size - 1)
        ]

    sg_chisq = SingleDetSGChisq.from_cli(opt, bank, opt.chisq_bins)

    logging.info("Full template bank size: %s", len(bank))
    bank.template_thinning(inj_filter_rejector)
    logging.info("Template bank size after thinning: %s", len(bank))

    if use_batching and hasattr(matched_filter, "batched_matched_filter_and_cluster"):
        try:
            logging.info("Warming up JAX JIT compilation during setup")
            _warmup_indices = list(range(min(batch_size, len(bank))))
            if hasattr(bank, "get_batch"):
                _warmup_batch = bank.get_batch(_warmup_indices)
            else:
                _warmup_batch = [bank[i] for i in _warmup_indices]
            _warmup_sig = [1.0] * len(_warmup_batch)
            from pycbc import scheme
            state = getattr(scheme.mgr, "state", None)
            if state is not None and hasattr(scheme, "JAXScheme") and isinstance(state, scheme.JAXScheme):
                from pycbc.filter.matchedfilter_jax import batch_sigmasq_jax
                _warmup_sig = batch_sigmasq_jax(_warmup_batch, segments[0].psd)
            matched_filter.batched_matched_filter_and_cluster(
                0, _warmup_batch, _warmup_sig, cluster_window, epoch=segments[0]._epoch
            )
            if power_chisq.do:
                if hasattr(_warmup_batch, "_batch_tensor") and _warmup_batch._batch_tensor is not None:
                    from pycbc.vetoes.chisq_jax import batch_power_chisq_bins_jax
                    from pycbc.waveform.bank import LazyFrequencySeries
                    num_bins = int(power_chisq.parse_option(_warmup_batch[0], power_chisq.num_bins))
                    _dummy_batch_bins = batch_power_chisq_bins_jax(
                        _warmup_batch, num_bins, segments[0].psd, low_frequency_cutoff=flow
                    )
                    _dummy_corr = LazyFrequencySeries(_warmup_batch._batch_tensor, 0, delta_f)
                    _dummy_corr._kmin = matched_filter.kmin
                    _dummy_corr._tlen = matched_filter.tlen
                    from pycbc.vetoes.chisq_jax import _batched_points_chisq_core
                    import jax
                    _kmin_f = float(matched_filter.kmin)
                    _n_time_f = float(matched_filter.tlen)
                    _bins_rel = jax.device_put(numpy.array(_dummy_batch_bins, dtype=numpy.int32) - int(_kmin_f))
                    for _bsz in (128, 256):
                        _r_buf = jax.device_put(numpy.zeros(_bsz, dtype=numpy.int32))
                        _p_buf = jax.device_put(numpy.zeros(_bsz, dtype=numpy.int32))
                        _res = _batched_points_chisq_core(
                            _warmup_batch._batch_tensor, _r_buf, _p_buf, _bins_rel, _kmin_f, _n_time_f, bucket_size=_bsz
                        )
                        _res.block_until_ready()
                    del _dummy_corr, _dummy_batch_bins, _bins_rel
                else:
                    _dummy_corr = _warmup_batch[0]
                    _dummy_bins = power_chisq.cached_chisq_bins(_warmup_batch[0], segments[0].psd)
                    for _pts in ([1000], [1000, 2000], [1000, 2000, 3000, 4000]):
                        vetoes.shift_sum(_dummy_corr, _pts, _dummy_bins)
                    del _dummy_corr, _dummy_bins
            del _warmup_batch, _warmup_sig
            # Reuse the prepared first batch in JAX searches. Resumed searches
            # start elsewhere, and other schemes retain their cleanup policy.
            reuse_warmup = (
                isinstance(state, getattr(scheme, "JAXScheme", ()))
                and tnum_start == 0
            )
            if not reuse_warmup:
                if hasattr(bank, "clear_batch_cache"):
                    bank.clear_batch_cache(_warmup_indices)
                if hasattr(matched_filter, "clear_batch_cache"):
                    matched_filter.clear_batch_cache()
            import gc
            gc.collect()
        except Exception as _exc:
            logging.warning("JAX JIT warmup pass skipped: %s", _exc)

    tsetup = time.time() - tstart
    tcheckpoint = time.time()

    tanalyze = list(range(tnum_start, len(bank)))
    if use_batching:
        n = opt.finalize_events_template_rate or max(batch_size * 8, 512)
    else:
        n = opt.finalize_events_template_rate
        n = 1 if n is None else n
    tchunks = [tanalyze[i:i + n] for i in range(0, len(tanalyze), n)]

    mmap = map
    if opt.multiprocessing_nprocesses:
        mmap = Pool(opt.multiprocessing_nprocesses).map

    for tchunk in tchunks:
        if use_batching:
            tbatches = [tchunk[i:i + batch_size] for i in range(0, len(tchunk), batch_size)]
            data = []
            for bdata in mmap(batch_template_triggers, tbatches):
                data.extend(bdata)
        else:
            data = list(mmap(template_triggers, tchunk))

        for elem in data:
            out_vals_all, tparam = elem
            if len(out_vals_all) > 0:
                event_mgr.new_template(tmplt=tparam)

                for edata in out_vals_all:
                    event_mgr.add_template_events(names, [edata[n] for n in names])

                event_mgr.cluster_template_events("time_index", "snr", cluster_window)
                event_mgr.finalize_template_events()

        if opt.finalize_events_template_rate is not None:
            event_mgr.consolidate_events(opt, gwstrain=gwstrain)

        if opt.checkpoint_interval and \
            (time.time() - tcheckpoint > opt.checkpoint_interval):
            event_mgr.save_state(max(tchunk), opt.output + '.checkpoint')
            tcheckpoint = time.time()

        if opt.checkpoint_exit_maxtime and \
            (time.time() - tstart > opt.checkpoint_exit_maxtime):
            event_mgr.save_state(max(tchunk), opt.output + '.checkpoint')
            sys.exit(opt.checkpoint_exit_code)

event_mgr.consolidate_events(opt, gwstrain=gwstrain)
event_mgr.finalize_events()
logging.info("Outputting %s triggers" % str(len(event_mgr.events)))

tstop = time.time()
run_time = tstop - tstart
event_mgr.save_performance(ncores, len(segments), len(bank), run_time, tsetup)

logging.info("Writing out triggers")
event_mgr.write_events(opt.output)

if opt.fft_backends == 'fftw':
    if opt.fftw_output_float_wisdom_file:
        fft.fftw.export_single_wisdom_to_filename(opt.fftw_output_float_wisdom_file)

    if opt.fftw_output_double_wisdom_file:
        fft.fftw.export_double_wisdom_to_filename(opt.fftw_output_double_wisdom_file)

logging.info("Finished")
