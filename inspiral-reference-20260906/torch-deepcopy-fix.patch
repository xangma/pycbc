--- a/pycbc/scheme.py
+++ b/pycbc/scheme.py
@@ -235,6 +235,12 @@ class TorchScheme(Scheme):
         self.num_threads = num_threads
         self._thread_state = None
 
+    def __deepcopy__(self, memo):
+        # Arrays share their processing context. Copying one must not clone
+        # the Torch module or ownership of saved process-wide thread settings.
+        memo[id(self)] = self
+        return self
+
     def _restore_thread_state(self):
         """Restore thread settings saved by the current context entry."""
         state = self._thread_state
